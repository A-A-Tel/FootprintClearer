<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:discord="clr-namespace:FootprintClearer.ViewModels.Discord"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="FootprintClearer.Views.Discord.DiscordLoginView"
             x:DataType="discord:DiscordLoginViewModel">
    
    <Grid RowDefinitions="*,600,*" ColumnDefinitions="*,900,*">
        <NativeWebView Grid.Row="1" Grid.Column="1" Source="https://www.discord.com/login" />
    </Grid>
</UserControl>
